# ── LLM ──────────────────────────────────────────────────────────────
# Provider primário: "anthropic" ou "openai"
LLM_PROVIDER=anthropic
# Fallback opcional (usado se o primário falhar de vez): "openai", "anthropic" ou vazio
LLM_FALLBACK_PROVIDER=

# Anthropic (API separada da assinatura Claude Pro — criar key em console.anthropic.com)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5

# OpenAI (criar key em platform.openai.com)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
# Só para modelos da família gpt-5 (reasoning). Deixe vazio para outros modelos.
OPENAI_REASONING_EFFORT=minimal

# ── Ilustração dos posts (etapa 2) ───────────────────────────────────
# Gerada no fim do run (1 por post) e commitada em data/media/.
GENERATE_ILLUSTRATIONS=true
# gpt-image-2 (~US$ 0,041/imagem) tem qualidade bem superior ao
# gpt-image-1-mini (~US$ 0,013) sob o escurecimento dos slides.
OPENAI_IMAGE_MODEL=gpt-image-2
OPENAI_IMAGE_QUALITY=medium
OPENAI_IMAGE_SIZE=1024x1536

# ── Pipeline ─────────────────────────────────────────────────────────
# "live" (coleta real + LLM real) ou "mock" (fixtures + LLM simulado, custo zero)
PIPELINE_MODE=live
NEWS_LOOKBACK_HOURS=18
MIN_STORIES_PER_VERTICAL=3
MAX_STORIES_PER_VERTICAL=5
TIMEZONE=America/Sao_Paulo
LOG_LEVEL=INFO
DATA_DIR=data
