{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "crons": [
    {
      "path": "/api/cron/run",
      "schedule": "0 9 * * *"
    },
    {
      "path": "/api/cron/ig-refresh",
      "schedule": "30 12 * * *"
    }
  ],
  "functions": {
    "src/app/api/**": {
      "memory": 2048
    }
  },
  "ignoreCommand": "git diff --quiet HEAD^ HEAD -- ':(top)web' ':(top)config' ':(top)prompts'"
}
